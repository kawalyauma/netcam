# Copied automatically by scripts/install.sh if missing. Compose reads this
# file automatically since it lives next to docker-compose.yml.
POSTGRES_USER=netcam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netcam

# network-agent runs on the HOST, not in this compose project — reachable
# from the api container via the Docker bridge gateway.
NETWORK_AGENT_URL=http://host.docker.internal:8787

# Whether the api container seeds default admin/packages on startup. Turn
# off once you've set your own data — it's idempotent either way (upserts).
SEED_ON_START=true
