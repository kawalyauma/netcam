PORT=8787
NETCAM_API_URL=http://127.0.0.1:3000
NETWORK_AGENT_SHARED_SECRET=change-me-too

# The interface that receives internet (WiFi client mode uplink).
WAN_INTERFACE=wlan0

# Comma-separated list of parentInterface:vlanId:routerId used to create the
# per-router VLAN sub-interfaces this box will route/DHCP for. Populate from
# the routers you create in the admin dashboard. Example for two routers on
# the built-in ethernet port and a USB adapter:
# eth0:10:<router-a-id>,enx001122334455:20:<router-b-id>
ROUTER_VLANS=

# Consumer-router fallback (no VLAN support). Connect the gateway Ethernet
# port to a LAN port on a router configured in AP/bridge mode, with that
# router's own DHCP server disabled. Format: parentInterface:subnetId:routerId
# Example: enp0s25:10:<router-id> creates 10.50.10.0/24 on enp0s25.
# Do not configure the same physical interface in both ROUTER_LANS and
# ROUTER_VLANS.
ROUTER_LANS=

# Base of the DHCP pool per router: <BASE>.<vlanId>.0/24, e.g. 10.50 -> 10.50.10.0/24 for vlan 10
DHCP_POOL_BASE=10.50

DNSMASQ_CONF_DIR=/etc/dnsmasq.d
DNSMASQ_LEASES_FILE=/var/lib/misc/dnsmasq.leases

# How often (ms) to sample TTLs per authorized MAC for the anti-resharing
# heuristic, and how many packets to sample each time. Uses tcpdump, which
# must be installed and runnable by this process (root).
TTL_SAMPLE_INTERVAL_MS=60000
TTL_SAMPLE_PACKET_COUNT=8
