NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://netcam:netcam@localhost:5432/netcam?schema=public

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Public HTTPS URL this box is reachable at, used for Ssentezo success/failure
# callbacks. Most vendor boxes sit behind home WiFi with no public IP, so this
# is OPTIONAL — leave blank to rely purely on status polling (payments.service
# polls PENDING transactions on a timer either way, callbacks are just a
# faster path when available, e.g. via a cloudflared/ngrok tunnel).
PUBLIC_BASE_URL=

# Ssentezo payment gateway (https://wallet.ssentezo.com/documentation)
# Use https://devwallet.ssentezo.com/api for sandbox testing.
SSENTEZO_BASE_URL=https://wallet.ssentezo.com/api
SSENTEZO_API_USER=
SSENTEZO_API_KEY=

# EGO SMS / Pahappa Comms API (https://developers.pahappa.com/)
EGO_SMS_BASE_URL=https://comms.egosms.co/api/v1/json/
EGO_SMS_USERNAME=
EGO_SMS_PASSWORD=
EGO_SMS_SENDER_ID=NetCam

# Network agent shared secret (API <-> network-agent auth)
NETWORK_AGENT_SHARED_SECRET=change-me-too
NETWORK_AGENT_URL=http://127.0.0.1:8787

CORS_ORIGIN=http://localhost:5173
